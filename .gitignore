# Secrets — .env* real, niciodată în git (doar *.example intră)
.env
.env.*
!.env.example
!.env.engine.example
!.env.llm.example
!.env.control.example

# Consola Angular
apps/console/node_modules/
apps/console/dist/
apps/console/.angular/
*.key
*.pem

# Stare locală runtime (halt flag, idempotency store, heartbeat) — niciodată în git
runtime/

# Python
venv/
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rapoarte de backtest generate local
backtests/reports/*
!backtests/reports/.gitkeep

# Date de test vendor descărcate de scripts/nautilus_qualification/fetch_test_data.py
# (pinned prin hash de commit + verificare sha256, nu trebuie ținute în git)
.cache/

# OS
.DS_Store
