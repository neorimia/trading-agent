# Variabile pentru procesul research izolat (src/research/).
# Copiază în .env.research (fără extensia .example) și completează local — .env.research NU intră în git.
#
# REGULĂ: aceste chei rămân în procesul research. Nu le copia în .env.engine.

# --- Mediu / server loopback ---
ENVIRONMENT=development
LOG_LEVEL=INFO
RESEARCH_SERVER_HOST=127.0.0.1
RESEARCH_SERVER_PORT=8766
RESEARCH_METADATA_DB_PATH=data/research/metadata.db
RESEARCH_STALE_AFTER_HOURS=24

# --- API keys (doar research) ---
FRED_API_KEY=
# Opțional — fără cheie BLS rămâne pe cota unregistered.
BLS_API_KEY=
BEA_API_KEY=

# User-Agent obligatoriu pentru data.sec.gov (descriere + email de contact).
RESEARCH_USER_AGENT=trading-agent-research your-email@example.com
