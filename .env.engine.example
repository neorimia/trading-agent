# Variabile pentru procesul "trading core" (data/engine/risk/execution/monitor/audit).
# Copiază în .env.engine (fără extensia .example) și completează local — .env.engine NU intră în git.
#
# ATENȚIE: acest fișier poate conține referințe la broker paper/sandbox, NICIODATĂ chei live
# (regula absolută #1 — vezi CLAUDE-instructiuni-faza-0-4.md §0).

# --- Mediu ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Broker / venue ---
# Paper (Faza 5): lasă cheile Kraken goale. Path B le interzice în mediu.
BROKER_PAPER_MODE=true
BROKER_NAME=KRAKEN
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=

# Live (doar după paper + policy). Nu pune niciodată aceste valori în .env.llm.
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_API_SECRET=
KRAKEN_SUBACCOUNT=false
KRAKEN_IP_WHITELIST_CONFIGURED=false
KRAKEN_KEY_WITHDRAW_ENABLED=false
LIVE_TRADING_ENABLED=false

# --- Client HTTP către procesul LLM izolat (src/llm/server.py) ---
LLM_SERVICE_URL=http://127.0.0.1:8765
LLM_SERVICE_TIMEOUT_SECONDS=30

# --- Config / risc ---
RISK_LIMITS_PATH=config/risk_limits.yaml
UNIVERSE_PATH=config/universe.yaml

# --- Market data (backtest CLI; paper/control încă interoghează OHLC live direct,
# nu scriu candele în faza asta) ---
# files = cache JSON per fereastră sub .cache/market_data/ (implicit, țintă de rollback).
# postgres = hypertable-ul ohlcv_candles — vezi docs/database-cutover-playbook.md
# §"Market data" pentru backfill/reconciliere (scripts/db/import_market_data.py).
MARKET_DATA_STORE_BACKEND=files
# Rol market_data_writer — niciodată credențialele research_writer/control_reader.
# MARKET_DATA_DATABASE_URL=postgresql://market_data_writer:local-dev-only@127.0.0.1:5432/trading_research

# --- Stare locală runtime (niciodată în git) ---
RUNTIME_DIR=runtime
HALT_FLAG_PATH=runtime/control/halt.flag
