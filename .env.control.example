# Variabile pentru procesul control plane (consola de operator).
# Copiază în .env.control — .env.control NU intră în git.
#
# Bind obligatoriu pe loopback. Nu pune chei de exchange aici; statusul cheilor
# e citit (redactat) din .env.engine dacă există.

ENVIRONMENT=development
LOG_LEVEL=INFO

CONTROL_SERVER_HOST=127.0.0.1
CONTROL_SERVER_PORT=8767
CONTROL_CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# Opțional: dacă e setat, consola trebuie să trimită Authorization: Bearer <token>
CONTROL_OPERATOR_TOKEN=
CONTROL_OPERATOR_ROLE=operator

RUNTIME_DIR=runtime/paper
HALT_FLAG_PATH=runtime/paper/control/halt.flag
RISK_LIMITS_PATH=config/risk_limits.yaml
UNIVERSE_PATH=config/universe.yaml
PAPER_CONFIG_PATH=config/paper_trading.yaml
STRATEGIES_PATH=config/strategies.yaml

# Conexiune read-only pentru control plane după cutover-ul research la PostgreSQL.
# Folosește exclusiv rolul reader; nu reutiliza RESEARCH_DATABASE_URL și nu pune
# credențialele writer din .env.research în acest fișier.
RESEARCH_STORE_BACKEND=postgres
CONTROL_DATABASE_URL=postgresql://control_reader:local-dev-only@127.0.0.1:5432/trading_research

# Fallback SQLite înainte de cutover și în timpul rollback-ului.
RESEARCH_METADATA_DB_PATH=data/research/metadata.db

# Execuție (Fazele 3+4): trebuie să fie egal cu EXECUTION_STORE_BACKEND din
# .env.engine — control citește balances/positions din PostgreSQL doar dacă
# engine-ul scrie acolo. Reutilizează CONTROL_DATABASE_URL (rolul control_reader are
# deja SELECT pe tabelele de execuție — deploy/postgres/create_roles.sql).
EXECUTION_STORE_BACKEND=json
# Numele portofoliului citit (= numele directorului runtime/paper*, scripts/db/seed.py).
EXECUTION_PORTFOLIO_NAME=paper

# Backtest/paper-run entities (Faza 6): files = backtests/jobs/*.json +
# backtests/reports/ pe disc (implicit, țintă de rollback — vezi
# docs/database-cutover-playbook.md domeniul 4). postgres = backtest_runs/
# backtest_trades scrise de control (src/control/backtest_jobs.py) +
# scripts/backtest/run_backtest.py; JSON-ul rămâne scris necondiționat oricum.
BACKTEST_STORE_BACKEND=files
# Rol backtest_writer — niciodată credențialele research_writer/control_reader/
# market_data_writer/execution_writer.
# BACKTEST_DATABASE_URL=postgresql://backtest_writer:local-dev-only@127.0.0.1:5432/trading_research

# Audit/aprobări/agent-runs/alerte/system-events (Faza 7): files = audit.sqlite +
# control/approvals/*.json pe disc (implicit, țintă de rollback). postgres =
# audit_log/human_approvals/agent_runs/alerts/system_events scrise de control
# (src/control/runtime_state.py, agent_process.py) — trebuie egal cu
# AUDIT_STORE_BACKEND din .env.engine, fiindcă ambele procese scriu în audit_log.
AUDIT_STORE_BACKEND=files
# Rol audit_writer, partajat cu procesul engine — niciodată celelalte roluri.
# AUDIT_DATABASE_URL=postgresql://audit_writer:local-dev-only@127.0.0.1:5432/trading_research

# Doar health ping (GET). Controlul nu apelează /propose.
LLM_SERVICE_URL=http://127.0.0.1:8765
RESEARCH_SERVICE_URL=http://127.0.0.1:8766
